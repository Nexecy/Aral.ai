# ==============================================================================
# Aral.ai Backend Configuration
# ==============================================================================

# Google Gemini API Key (Get at https://aistudio.google.com/)
GEMINI_API_KEY=

# Supabase Credentials (Get from your Supabase Project Settings -> API)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Public website URL used in confirmation / reset emails
FRONTEND_URL=http://localhost:3000
PRODUCTION_FRONTEND_URL=https://aral-ai-three.vercel.app

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,https://aral-ai-three.vercel.app,tauri://localhost,capacitor://localhost
