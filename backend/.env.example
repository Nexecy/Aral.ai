# ==============================================================================
# Aral.ai Backend Configuration
# ==============================================================================

# Google Gemini API Key (Get at https://aistudio.google.com/)
GEMINI_API_KEY=

# Supabase Credentials (Get from your Supabase Project Settings -> API)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,tauri://localhost,capacitor://localhost
