# ==============================================================================
# Aral.ai Frontend Configuration
# ==============================================================================

# Local Development (FastAPI backend running locally on port 8000)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Remote / Production Backend (uncomment if connecting frontend to a remote server):
# NEXT_PUBLIC_API_URL=https://aral-ai.onrender.com/api

# Web3Forms Access Key for Contact Email Dispatch (https://web3forms.com)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Resend API Key for Branded HTML Contact Emails (https://resend.com)
RESEND_API_KEY=your_resend_api_key_here
