# ==============================================================================
# Aral.ai Frontend Configuration
# ==============================================================================

# Local development — FastAPI on port 8000, Next.js on port 3005
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Vercel / production (set this in the Vercel project Environment Variables):
# NEXT_PUBLIC_API_URL=https://aral-ai-api-686935671952.us-central1.run.app/api

# Optional: Google Identity Services client id (falls back to the shipped web client)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: Supabase project URL for social OAuth popups
# NEXT_PUBLIC_SUPABASE_URL=

# Web3Forms Access Key for Contact Email Dispatch (https://web3forms.com)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Resend API Key for Branded HTML Contact Emails (https://resend.com)
# Used by the Next.js /api/contact route on Vercel (not available in static export)
RESEND_API_KEY=your_resend_api_key_here
